# WrapShop OS — copy to .env.local for development.
# The env.ts file validates these at boot time.

# ---- Node ----
NODE_ENV="development"

# ---- Supabase ----
# Use the "Session" pooler URL (port 6543) with pgbouncer options for runtime queries.
DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) for Prisma migrate ONLY.
DIRECT_URL="postgresql://postgres.xxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32+ random bytes hex — used for AES-GCM encryption of OAuth tokens stored in DB.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_32_BYTES_HEX"

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="no-reply@yourshop.com"

# ---- QuickBooks Online (Intuit) ----
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_WEBHOOK_VERIFIER=""
QBO_ENVIRONMENT="sandbox"

# ---- Inngest ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
